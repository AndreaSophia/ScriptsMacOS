#!/bin/bash
# =============================================================================
# Meridian — entrypoint
# Herramienta de diagnóstico profesional para macOS Enterprise
# Apple Platform Team — Itaú
#
# Uso:
#   sudo meridian [opciones]
#
# Opciones:
#   --module <id>    Ejecutar un módulo específico
#   --category <cat> Ejecutar todos los módulos de una categoría
#   --all            Ejecutar todos los módulos (default)
#   --test           Modo test con fixtures (sin llamadas al sistema real)
#   --debug          Logs detallados
#   --no-report      No generar reportes (solo mostrar en pantalla)
#   --help           Mostrar esta ayuda
#
# Compatibilidad:
#   macOS Sonoma (14) | Sequoia (15) | Tahoe (16)
#   Apple Silicon (arm64) | Intel (x86_64) | bash 3.2+
# =============================================================================

set -euo pipefail

# --- Directorio raíz del proyecto ---
MERIDIAN_ROOT="$(cd "$(dirname "$0")" && pwd)"
export MERIDIAN_ROOT

# --- Versión ---
MERIDIAN_VERSION="$(cat "${MERIDIAN_ROOT}/VERSION" 2>/dev/null | tr -d '[:space:]')"
export MERIDIAN_VERSION

MERIDIAN_ORG="Apple Platform Team"
export MERIDIAN_ORG

# =============================================================================
# _load_core — Carga todos los módulos del core en orden de dependencias
# =============================================================================
_load_core() {
  local core_files=(
    "logging/logger.sh"
    "core/result_model.sh"
    "core/module_registry.sh"
    "core/result_aggregator.sh"
    "core/privilege_manager.sh"
    "core/module_loader.sh"
    "rules/rule_loader.sh"
    "rules/rule_engine.sh"
    "core/repair_engine.sh"
    "core/validation_engine.sh"
    "core/engine.sh"
    "services/diagnostic_service.sh"
    "reporting/renderer_txt.sh"
    "reporting/renderer_json.sh"
    "services/reporting_service.sh"
    "ui/tui/menu.sh"
    "ui/tui/result_display.sh"
    "ui/tui/confirm_dialog.sh"
  )

  local f
  for f in "${core_files[@]}"; do
    local path="${MERIDIAN_ROOT}/${f}"
    if [ ! -f "$path" ]; then
      echo "[FATAL] Componente no encontrado: $path" >&2
      exit 1
    fi
    # shellcheck source=/dev/null
    source "$path"
  done
}

# =============================================================================
# _parse_args — Procesa argumentos de línea de comandos
# =============================================================================
_parse_args() {
  _OPT_MODULES=()
  _OPT_CATEGORY=""
  _OPT_ALL=true
  _OPT_REPORT=true
  export MERIDIAN_DEBUG=0
  export MERIDIAN_TEST_MODE=0
  export MERIDIAN_FIXTURE_DIR="${MERIDIAN_ROOT}/tests/fixtures"

  while [ $# -gt 0 ]; do
    case "$1" in
      --module)
        _OPT_ALL=false
        _OPT_MODULES+=("${2:?'--module requiere un ID de módulo'}")
        shift 2
        ;;
      --category)
        _OPT_ALL=false
        _OPT_CATEGORY="${2:?'--category requiere una categoría'}"
        shift 2
        ;;
      --all)
        _OPT_ALL=true
        shift
        ;;
      --test)
        export MERIDIAN_TEST_MODE=1
        shift
        ;;
      --debug)
        export MERIDIAN_DEBUG=1
        shift
        ;;
      --no-report)
        _OPT_REPORT=false
        shift
        ;;
      --help|-h)
        _show_help
        exit 0
        ;;
      *)
        echo "[WARN] Argumento desconocido: $1" >&2
        shift
        ;;
    esac
  done
}

# =============================================================================
# _show_help
# =============================================================================
_show_help() {
  cat <<HELP

Meridian v${MERIDIAN_VERSION} — ${MERIDIAN_ORG}

USO:
  sudo meridian [opciones]

OPCIONES:
  --module <id>    Ejecutar módulo específico (ej: filevault, crowdstrike)
  --category <cat> Ejecutar categoría (security, edr, mdm, network)
  --all            Ejecutar todos los módulos (default)
  --test           Modo test — usa fixtures sin llamar al sistema real
  --debug          Logs detallados
  --no-report      Solo pantalla, sin generar archivos de reporte
  --help           Esta ayuda

MÓDULOS DISPONIBLES:
  filevault        FileVault Disk Encryption
  certificates     Certificates & Trust Store
  crowdstrike      CrowdStrike Falcon EDR
  cisco_umbrella   Cisco Umbrella DNS Security
  forcepoint       Forcepoint Web Security
  workspace_one    Workspace ONE Intelligent Hub

EJEMPLOS:
  sudo meridian
  sudo meridian --module crowdstrike
  sudo meridian --category security
  sudo meridian --test --debug

SALIDA:
  ~/Desktop/Meridian_<hostname>_<timestamp>/
    Executive_Report.txt
    results.json
    diagnostic.log
    evidencias/<module>/

HELP
}

# =============================================================================
# _build_output_dir — Construye la ruta de salida en el Desktop del usuario real
# =============================================================================
_build_output_dir() {
  local real_home
  if [ -n "${SUDO_USER:-}" ]; then
    real_home="$(eval echo "~${SUDO_USER}" 2>/dev/null || echo "/tmp")"
  else
    real_home="$HOME"
  fi

  local hostname
  hostname="$(hostname -s 2>/dev/null || echo 'unknown')"
  local ts
  ts="$(date '+%Y%m%d_%H%M%S')"

  echo "${real_home}/Desktop/Meridian_${hostname}_${ts}"
}

# =============================================================================
# _resolve_modules — Construye la lista final de módulos a ejecutar
# =============================================================================
_resolve_modules() {
  local result=()

  if [ ${#_OPT_MODULES[@]} -gt 0 ]; then
    result=("${_OPT_MODULES[@]}")
  elif [ -n "$_OPT_CATEGORY" ]; then
    while IFS= read -r id; do
      [ -n "$id" ] && result+=("$id")
    done < <(registry_get_by_category "$_OPT_CATEGORY")

    if [ ${#result[@]} -eq 0 ]; then
      log_warn "meridian" "No se encontraron módulos para la categoría: ${_OPT_CATEGORY}"
    fi
  fi
  # Si result está vacío y _OPT_ALL=true, engine_run sin args ejecuta todos

  echo "${result[@]:-}"
}

# =============================================================================
# main
# =============================================================================
main() {
  _load_core
  _parse_args "$@"

  # Verificar root antes de cualquier cosa
  privilege_require_root

  local output_dir
  output_dir="$(_build_output_dir)"

  # Mostrar banner
  tui_banner

  # Si es modo interactivo (sin args de módulo explícitos), mostrar menú
  local selected_modules=()
  if [ "$_OPT_ALL" = "true" ] && [ ${#_OPT_MODULES[@]} -eq 0 ] && \
     [ -z "$_OPT_CATEGORY" ]; then

    # Necesitamos cargar módulos antes del menú para mostrar opciones
    # Inicializar dirs y logger temporalmente
    mkdir -p "$output_dir" 2>/dev/null
    logger_init "${output_dir}/diagnostic.log"

    module_loader_discover "${MERIDIAN_ROOT}/modules"
    rule_loader_load "${MERIDIAN_ROOT}/rules/definitions"

    local menu_selection
    menu_selection="$(tui_menu_main)"

    if [ "$menu_selection" = "all" ] || [ -z "$menu_selection" ]; then
      _OPT_ALL=true
    else
      _OPT_ALL=false
      for id in $menu_selection; do
        selected_modules+=("$id")
      done
    fi

    # Ejecutar directamente — el engine ya tiene módulos cargados
    printf "\n"
    log_step "Iniciando diagnóstico"

    engine_run "${selected_modules[@]:-}"

  else
    # Modo no-interactivo: engine_init carga todo desde cero
    diagnostic_service_run "$output_dir" "${_OPT_MODULES[@]:-}"
  fi

  # Mostrar resultados en pantalla
  local results
  results="$(engine_get_results)"
  tui_display_results "$results"

  local summary
  summary="$(engine_get_summary)"
  tui_display_summary "$summary"

  # Generar reportes
  local txt_path="" json_path=""
  if [ "$_OPT_REPORT" = "true" ]; then
    txt_path="$(renderer_txt_generate "$output_dir" "$results" "$summary")"
    json_path="$(renderer_json_generate "$output_dir" "$results" "$summary")"

    # Crear ZIP
    local zip_name="Meridian_$(hostname -s 2>/dev/null || echo unknown)_$(date '+%Y%m%d_%H%M%S').zip"
    local real_home
    if [ -n "${SUDO_USER:-}" ]; then
      real_home="$(eval echo "~${SUDO_USER}" 2>/dev/null || echo "/tmp")"
    else
      real_home="$HOME"
    fi
    local zip_path="${real_home}/Desktop/${zip_name}"

    ( cd "$(dirname "$output_dir")" && \
      zip -r "$zip_name" "$(basename "$output_dir")" >/dev/null 2>&1 && \
      mv "$zip_name" "$zip_path" 2>/dev/null ) || true

    tui_display_output_paths "$output_dir" "$txt_path" "$json_path"

    if [ -f "$zip_path" ]; then
      printf "  \033[1;32mZIP listo   : %s\033[0m\n\n" "$zip_path"
    fi
  fi

  log_audit "meridian" "SESSION_COMPLETED" \
    "modules=$(aggregator_count) pass=$(aggregator_count_by_status PASS) fail=$(aggregator_count_by_status FAIL)"
}

main "$@"
